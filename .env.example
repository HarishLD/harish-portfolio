# Copy to .env.local for local development. Never commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser; this site has no secrets today.

# Canonical URL used for metadata, OG images and the sitemap.
# Local: http://localhost:3000 · Production: your custom domain (set in Vercel).
# Leave unset on Vercel previews: the deployment URL is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
